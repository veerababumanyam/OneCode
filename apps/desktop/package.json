{
  "name": "onecode-desktop-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:version && npm run check:tokens && npm run typecheck && npm test && vite build",
    "check:tokens": "node ../../../OneQuill/docs/design/onequill-design-system/token-lint.mjs src",
    "check:version": "node ../../scripts/sync-version.mjs --check",
    "preview": "vite preview --host 127.0.0.1",
    "sync:version": "node ../../scripts/sync-version.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "onequill-design-system": "file:../../../OneQuill/docs/design/onequill-design-system",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "26.1.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
