# Normalize text to LF in the repository; Windows scripts keep CRLF.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets.
*.woff2 binary
*.png binary
*.jpg binary
*.ico binary
*.docx binary

# Generated files: collapse in diffs.
package-lock.json linguist-generated=true -diff
Cargo.lock linguist-generated=true
